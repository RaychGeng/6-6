<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>创始人 Ray Geng - 火花课堂</title>
    <!-- 引入Font Awesome图标 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- 引入Google字体 -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <!-- 引入Swiper轮播 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css">
    <!-- 引入AOS动画库 -->
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">
    <!-- 引入Lightbox库 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/css/lightbox.min.css" rel="stylesheet">
    <!-- 自定义CSS -->
    <link rel="stylesheet" href="styles.css">
    <style>
        /* 创始人页面特定样式 */
        .founder-hero {
            background: linear-gradient(135deg, #FF6B35 0%, #FF9E5D 100%);
            color: #fff;
            padding: 100px 0 50px;
            position: relative;
            overflow: hidden;
        }
        
        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(255, 107, 53, 0.5) 0%, rgba(255, 193, 7, 0.3) 100%);
            z-index: 1;
        }
        
        .founder-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none"><polygon fill="rgba(255,255,255,0.15)" points="0,100 100,0 100,100"/></svg>');
            background-size: cover;
        }
        
        /* 添加动态元素 */
        .sparks {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 1;
            overflow: hidden;
        }
        
        .spark {
            position: absolute;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background-color: rgba(255, 255, 255, 0.8);
            box-shadow: 0 0 10px rgba(255, 193, 7, 0.8), 0 0 20px rgba(255, 107, 53, 0.6);
            animation: sparkle 4s infinite ease-in-out;
        }
        
        .spark-1 {
            top: 15%;
            left: 10%;
            animation-delay: 0s;
        }
        
        .spark-2 {
            top: 25%;
            right: 15%;
            animation-delay: 1s;
        }
        
        .spark-3 {
            bottom: 20%;
            left: 20%;
            animation-delay: 2s;
        }
        
        .spark-4 {
            bottom: 30%;
            right: 20%;
            animation-delay: 1.5s;
        }
        
        .spark-5 {
            top: 40%;
            left: 30%;
            animation-delay: 0.5s;
        }
        
        @keyframes sparkle {
            0%, 100% { 
                transform: scale(1);
                opacity: 0.4;
            }
            50% { 
                transform: scale(1.5);
                opacity: 1;
            }
        }
        
        .founder-hero .container {
            position: relative;
            z-index: 2;
        }
        
        .founder-profile {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 40px;
            margin-bottom: 30px;
        }
        
        .founder-avatar {
            width: 280px;
            height: 280px;
            border-radius: 50%;
            overflow: hidden;
            border: 5px solid #fff;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
        }
        
        .founder-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .founder-info {
            flex: 1;
            min-width: 300px;
        }
        
        .founder-info h1 {
            font-size: 36px;
            margin-bottom: 5px;
            position: relative;
            display: inline-block;
            color: #ffffff;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
        }
        
        .founder-info h1::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 60px;
            height: 3px;
            background: #ffffff;
        }
        
        .founder-title {
            font-size: 22px;
            margin-bottom: 20px;
            padding-top: 15px;
            color: #ffffff;
            font-weight: 600;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
        }
        
        .founder-intro-wrapper {
            background-color: rgba(255, 255, 255, 0.15);
            border-radius: 10px;
            padding: 5px;
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        
        .founder-intro {
            line-height: 1.8;
            font-size: 17px;
            margin-bottom: 0;
            padding: 15px;
            color: #ffffff;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
            background-color: rgba(255, 107, 53, 0.1);
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .section-header {
            margin: 60px 0 30px;
            position: relative;
            color: #FF6B35;
            font-size: 28px;
        }
        
        .section-header::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 40px;
            height: 3px;
            background: #FF9E5D;
        }
        
        .achievement-list, .skills-list {
            list-style-type: none;
            padding-left: 0;
        }
        
        .achievement-list li, .skills-list li {
            padding: 15px 0;
            border-bottom: 1px dashed rgba(255, 107, 53, 0.2);
            position: relative;
            padding-left: 30px;
            color: #444;
            transition: all 0.3s ease;
        }
        
        .achievement-list li:hover, .skills-list li:hover {
            transform: translateX(5px);
            color: #FF6B35;
            background-color: rgba(255, 158, 93, 0.05);
            border-radius: 5px;
            padding-left: 35px;
        }
        
        .achievement-list li::before, .skills-list li::before {
            content: "\f058";
            font-family: "Font Awesome 5 Free";
            font-weight: 900;
            color: #FF9E5D;
            position: absolute;
            left: 0;
        }
        
        .achievement-list li a {
            color: #FF6B35;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s;
        }
        
        .achievement-list li a:hover {
            color: #FF9E5D;
            text-decoration: underline;
        }
        
        .vision-section {
            background-color: #f9f9f9;
            padding: 70px 0;
            margin-top: 50px;
        }
        
        .vision-container {
            background: #fff;
            border-radius: 10px;
            padding: 40px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.05);
        }
        
        .vision-title {
            font-size: 24px;
            color: #FF6B35;
            margin-bottom: 20px;
            position: relative;
            display: inline-block;
        }
        
        .vision-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 40px;
            height: 3px;
            background: #FF9E5D;
        }
        
        .contact-section {
            margin-top: 50px;
            padding: 30px 0 70px;
        }
        
        .contact-card {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 25px;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            margin-bottom: 20px;
        }
        
        .contact-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }
        
        .contact-icon {
            font-size: 30px;
            color: #FF6B35;
            background: rgba(255, 107, 53, 0.1);
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }
        
        .contact-info {
            flex: 1;
        }
        
        .contact-info h3 {
            margin: 0 0 5px;
            font-size: 20px;
            color: #333;
        }
        
        .contact-info p {
            margin: 0;
            color: #666;
        }
        
        .contact-info a {
            color: #FF6B35;
            text-decoration: none;
            transition: all 0.3s;
        }
        
        .contact-info a:hover {
            color: #FF9E5D;
            text-decoration: underline;
        }
        
        @media (max-width: 768px) {
            .founder-profile {
                flex-direction: column;
                text-align: center;
            }
            
            .founder-avatar {
                margin: 0 auto;
            }
            
            .founder-info h1::after {
                left: 50%;
                transform: translateX(-50%);
            }
            
            .section-header {
                text-align: center;
            }
            
            .section-header::after {
                left: 50%;
                transform: translateX(-50%);
            }
            
            .vision-title {
                text-align: center;
                display: block;
            }
            
            .vision-title::after {
                left: 50%;
                transform: translateX(-50%);
            }
        }
        
        /* 照片集样式 */
        .photo-gallery-section {
            padding: 50px 0;
            background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
            overflow: hidden;
            position: relative;
        }
        
        .photo-gallery-section::before {
            content: '';
            position: absolute;
            top: -50px;
            left: -50px;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(255, 107, 53, 0.2) 0%, rgba(255, 158, 93, 0.2) 100%);
            animation: float 15s infinite ease-in-out;
        }
        
        .photo-gallery-section::after {
            content: '';
            position: absolute;
            bottom: -80px;
            right: -80px;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(255, 158, 93, 0.15) 0%, rgba(255, 107, 53, 0.15) 100%);
            animation: float 20s infinite ease-in-out reverse;
        }
        
        .photo-gallery {
            margin-top: 30px;
            padding: 20px 0;
            position: relative;
        }
        
        .founder-photos-swiper {
            width: 100%;
            padding-bottom: 60px;
            overflow: visible;
        }
        
        .photo-card {
            position: relative;
            width: 100%;
            height: 450px;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
            transition: all 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
            transform: perspective(1000px) rotateY(0deg);
            transform-style: preserve-3d;
        }
        
        .photo-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, 
                rgba(0, 0, 0, 0) 70%, 
                rgba(0, 0, 0, 0.5) 100%);
            z-index: 1;
        }
        
        .photo-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 1s cubic-bezier(0.165, 0.84, 0.44, 1);
        }
        
        .swiper-slide {
            transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            opacity: 0.4;
            transform: scale(0.75) translateY(30px);
            filter: blur(2px);
        }
        
        .swiper-slide-active {
            opacity: 1;
            transform: scale(1) translateY(0);
            z-index: 2;
            filter: blur(0);
        }
        
        .swiper-slide-active .photo-card {
            box-shadow: 0 25px 60px rgba(255, 107, 53, 0.3), 
                        0 10px 20px rgba(0, 0, 0, 0.2);
        }
        
        .swiper-slide-active .photo-img {
            transform: scale(1.05);
        }
        
        .swiper-slide-active .photo-card:hover {
            transform: perspective(1000px) rotateY(5deg);
            box-shadow: -25px 25px 60px rgba(255, 107, 53, 0.4), 
                        -10px 10px 20px rgba(0, 0, 0, 0.25);
        }
        
        .swiper-slide-active .photo-card:hover .photo-img {
            transform: scale(1.1);
        }
        
        .swiper-pagination {
            position: relative;
            bottom: -10px;
        }
        
        .swiper-pagination-bullet {
            width: 12px;
            height: 12px;
            background-color: rgba(255, 107, 53, 0.3);
            opacity: 0.5;
            transition: all 0.4s ease;
        }
        
        .swiper-pagination-bullet-active {
            width: 30px;
            border-radius: 6px;
            background-color: #FF6B35;
            opacity: 1;
        }
        
        .swiper-button-next,
        .swiper-button-prev {
            color: transparent;
            background-color: white;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            overflow: hidden;
        }
        
        .swiper-button-next::before,
        .swiper-button-prev::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #FF6B35 0%, #FF9E5D 100%);
            opacity: 0;
            transition: opacity 0.4s ease;
        }
        
        .swiper-button-next:after,
        .swiper-button-prev:after {
            font-size: 20px;
            font-weight: bold;
            color: #FF6B35;
            z-index: 1;
            position: relative;
            transition: color 0.4s ease;
        }
        
        .swiper-button-next:hover,
        .swiper-button-prev:hover {
            transform: scale(1.15);
            box-shadow: 0 8px 25px rgba(255, 107, 53, 0.4);
        }
        
        .swiper-button-next:hover::before,
        .swiper-button-prev:hover::before {
            opacity: 1;
        }
        
        .swiper-button-next:hover:after,
        .swiper-button-prev:hover:after {
            color: white;
        }
        
        @keyframes float {
            0%, 100% {
                transform: translate(0, 0);
            }
            25% {
                transform: translate(15px, -15px);
            }
            50% {
                transform: translate(0, -30px);
            }
            75% {
                transform: translate(-15px, -15px);
            }
        }
        
        /* 添加光影效果 */
        .section-header {
            position: relative;
            display: inline-block;
        }
        
        .section-header::before {
            content: '';
            position: absolute;
            bottom: -20px;
            left: 0;
            width: 60px;
            height: 3px;
            background: linear-gradient(90deg, #FF6B35, transparent);
            transition: width 0.4s ease;
        }
        
        .section-header:hover::before {
            width: 100%;
        }
        
        @media (max-width: 768px) {
            .photo-card {
                height: 350px;
            }
        }
        
        @media (max-width: 480px) {
            .photo-card {
                height: 280px;
            }
        }
    </style>
</head>
