// 游戏模块JavaScript
// 全局变量
let matchCount = 0; // 用于跟踪麻将游戏的匹配数量
let moveCount = 0; // 用于跟踪华容道的移动次数

// 加载中文字体
function loadChineseFont() {
    const fontLink = document.createElement('link');
    fontLink.rel = 'stylesheet';
    fontLink.href = 'https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&display=swap';
    document.head.appendChild(fontLink);
}

// 页面加载完成后调用
document.addEventListener('DOMContentLoaded', function() {
    loadChineseFont();
    // 找到"益智游戏"菜单项
    const gameMenuItems = document.querySelectorAll('.nav-item');
    gameMenuItems.forEach(item => {
        const span = item.querySelector('span');
        if (span && span.textContent === '益智游戏') {
            // 为"益智游戏"菜单项添加特殊的点击事件处理
            item.addEventListener('click', function(e) {
                // 不再跳转到games.html，而是在主内容区域显示游戏内容
                showGamesInMainContent();
                
                // 移除所有菜单项的active类
                gameMenuItems.forEach(nav => nav.classList.remove('active'));
                
                // 给当前点击的菜单项添加active类
                this.classList.add('active');
            });
        }
    });
});

// 在主内容区域显示游戏
function showGamesInMainContent() {
    // 获取主内容区域
    const mainContent = document.querySelector('.main-content');
    if (!mainContent) return;
    
    // 清空主内容区域
    mainContent.innerHTML = '';
    
    // 创建游戏页面标题
    const header = document.createElement('div');
    header.className = 'dashboard-header';
    header.innerHTML = `
        <h1 class="dashboard-title">益智游戏</h1>
        <div class="dashboard-actions">
            <button class="dashboard-btn">
                <i class="fas fa-trophy"></i>
                我的成就
            </button>
            <button class="dashboard-btn primary">
                <i class="fas fa-gamepad"></i>
                全部游戏
            </button>
        </div>
    `;
    
    mainContent.appendChild(header);
    
    // 创建游戏容器
    const gamesContainer = document.createElement('div');
    gamesContainer.className = 'games-container';
    
    // 游戏数据
    const games = [
        {
            id: 'poetry-game',
            title: '古诗飞花令',
            desc: '挑战你的古诗词知识，回答含有指定字的诗句！',
            image: 'https://via.placeholder.com/300x160',
            badge: 'hot'
        },
        {
            id: 'number-puzzle',
            title: '数字华容道',
            desc: '通过滑动数字方块，将它们排列成正确顺序。',
            image: 'https://via.placeholder.com/300x160',
            badge: 'new'
        },
        {
            id: 'english-mahjong',
            title: '英语版麻将',
            desc: '将传统麻将与英语学习结合，使用英文字母牌拼词胡牌，提升英语词汇量和记忆力！',
            image: 'images/english-mahjong.png',
            badge: 'reward'
        }
    ];
    
    // 为每个游戏创建卡片
    games.forEach(game => {
        const gameCard = document.createElement('div');
        gameCard.className = 'game-card';
        gameCard.innerHTML = `
            <div class="game-image">
                <img src="${game.image}" alt="${game.title}">
                ${game.badge ? `<div class="game-badge ${game.badge}">${game.badge === 'hot' ? '热门' : game.badge === 'new' ? '新游戏' : '有奖励'}</div>` : ''}
            </div>
            <div class="game-content">
                <div class="game-title">${game.title}</div>
                <div class="game-desc">${game.desc}</div>
                <div class="game-meta">
                    <span><i class="fas fa-users"></i> 5000+ 玩家</span>
                    <span><i class="fas fa-star"></i> 4.8</span>
                </div>
                <button class="game-btn" onclick="showGameContent('${game.id}')">开始游戏</button>
            </div>
        `;
        gamesContainer.appendChild(gameCard);
    });
    
    mainContent.appendChild(gamesContainer);
    
    // 在window对象上定义showGameContent方法，使其可以在游戏按钮的onclick中调用
    window.showGameContent = function(gameId) {
        showSpecificGameContent(gameId);
    };
}

