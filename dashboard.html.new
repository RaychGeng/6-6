        }
        
        .contribution-label {
            font-size: 0.85rem;
            color: var(--gray-text);
        }
        
        .contribution-certificate {
            display: flex;
            align-items: center;
            background: rgba(0,0,0,0.02);
            border-radius: 12px;
            padding: 15px;
            gap: 20px;
