            color: var(--dark-text);
            margin-bottom: 20px;
            position: relative;
            display: inline-block;
        }
        
        .charity-projects h3::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 30px;
            height: 2px;
            background: var(--anime-gradient);
            border-radius: 2px;
        }
        
        .projects-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }
        
        .project-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.05);
            overflow: hidden;
            transition: var(--transition);
        }
        
        .project-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(255, 107, 53, 0.1);
        }
        
        .project-image {
            height: 160px;
            position: relative;
            overflow: hidden;
        }
        
        .project-image img {
