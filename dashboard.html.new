<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>火花课堂 - 个人中心</title>
    <!-- 引入Font Awesome图标 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- 引入Google字体 -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <!-- 引入Swiper轮播 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css">
    <!-- 引入AOS动画�?-->
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">
    <!-- 自定义CSS -->
    <link rel="stylesheet" href="styles.css">
    <style>
        :root {
            --primary-color: #FF6B35;
            --accent-color: #FFC107;
            --anime-accent: #FD5E53;
            --anime-accent-2: #FFBD69;
            --dark-text: #2C3E50;
            --gray-text: #7F8C8D;
            --light-bg: #F5F7FA;
            --border-color: #E1E5EA;
            --success-color: #4CAF50;
            --warning-color: #FF9800;
            --danger-color: #F44336;
            --info-color: #2196F3;
            --transition: all 0.3s ease;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            --card-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
            --spark-gradient: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
            --header-height: 80px;
            --anime-gradient: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
            --box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        
        /* 全局样式 */
        body {
            font-family: 'Roboto', 'Poppins', sans-serif;
            background-color: var(--light-bg);
            color: var(--dark-text);
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        a {
            text-decoration: none;
            color: inherit;
        }
        
        /* 顶部导航栏样�?*/
        .header {
            background-color: white;
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 100;
            height: var(--header-height);
        }
        
        .header .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 100%;
        }
        
        .logo {
            display: flex;
            align-items: center;
        }
        
        .logo h1 {
            font-size: 1.5rem;
            margin: 0;
            color: var(--primary-color);
            font-weight: 700;
            text-shadow: 2px 2px 0 rgba(255, 105, 180, 0.1);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .logo h1 i {
            color: var(--anime-accent);
        }
        
        .sub-logo {
            font-size: 0.8rem;
            opacity: 0.8;
            font-weight: 500;
            letter-spacing: 1px;
            margin-left: 5px;
        }
        
        .logo img {
            height: 40px;
        }
        
        .main-nav {
            display: flex;
            margin-left: 30px;
        }
        
        .nav-list {
            display: flex;
            list-style: none;
            margin: 0;
            padding: 0;
        }
        
        .nav-list li {
            margin: 0 15px;
        }
        
        .nav-list a {
            font-weight: 500;
            padding: 10px 0;
            position: relative;
            color: var(--dark-text);
            transition: var(--transition);
        }
        
        .nav-list a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--anime-gradient);
            transition: var(--transition);
        }
        
        .nav-list a:hover {
            color: var(--primary-color);
        }
        
        .nav-list a:hover::after,
        .nav-list a.active::after {
            width: 100%;
        }
        
        .header-actions {
            display: flex;
            align-items: center;
        }
        
        .search-bar {
            display: flex;
            align-items: center;
            background: var(--light-bg);
            border-radius: 8px;
            padding: 5px 10px;
            max-width: 250px;
        }
        
        .search-bar input {
            background: none;
            border: none;
            outline: none;
            padding: 8px;
            font-size: 0.9rem;
            color: var(--dark-text);
            width: 100%;
        }
        
        .search-bar button {
            background: none;
            border: none;
            color: var(--gray-text);
            cursor: pointer;
            transition: var(--transition);
            padding: 5px;
        }
        
        .search-bar button:hover {
            color: var(--primary-color);
        }
        
        /* 用户中心界面样式 */
        .dashboard {
            display: flex;
            min-height: calc(100vh - var(--header-height));
            padding-top: 20px;
        }
        
        /* 左侧导航栏样�?*/
        .sidebar {
            width: 240px;
            background: white;
            border-radius: 15px;
            padding: 20px 0;
            box-shadow: var(--box-shadow);
            margin-right: 20px;
            flex-shrink: 0;
            position: sticky;
            top: calc(var(--header-height) + 20px);
            max-height: calc(100vh - var(--header-height) - 40px);
            overflow-y: auto;
        }
        
        .sidebar-header {
            padding: 0 20px 15px;
            border-bottom: 1px solid rgba(0,0,0,0.1);
            margin-bottom: 15px;
        }
        
        .user-profile {
            display: flex;
            align-items: center;
            padding: 0 20px 15px;
            border-bottom: 1px solid rgba(0,0,0,0.1);
            margin-bottom: 15px;
        }
        
        .user-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            overflow: hidden;
            background: var(--anime-gradient);
            position: relative;
        }
        
        .user-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .user-info {
            margin-left: 15px;
        }
        
        .user-name {
            font-weight: 600;
            margin-bottom: 3px;
            color: var(--dark-text);
        }
        
        .user-level {
            font-size: 0.8rem;
            color: var(--primary-color);
        }
        
        .nav-section {
            padding: 0 0 15px;
        }
        
        .nav-section-title {
            padding: 10px 20px;
            font-weight: 600;
            color: var(--gray-text);
            font-size: 0.9rem;
            text-transform: uppercase;
        }
        
        .nav-item {
            padding: 10px 20px;
            display: flex;
            align-items: center;
            color: var(--dark-text);
            transition: var(--transition);
            cursor: pointer;
            position: relative;
        }
        
        .nav-item:hover {
            background-color: rgba(255, 107, 53, 0.1);
            color: var(--primary-color);
        }
        
        .nav-item.active {
            background-color: rgba(255, 107, 53, 0.15);
            color: var(--primary-color);
            font-weight: 500;
        }
        
        .nav-item.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 4px;
            background: var(--anime-gradient);
            border-radius: 0 2px 2px 0;
        }
        
        .nav-item i {
            margin-right: 10px;
            font-size: 1.1rem;
            width: 20px;
            text-align: center;
        }
        
        .nav-item .badge {
            margin-left: auto;
            background: var(--anime-gradient);
            color: white;
            border-radius: 20px;
            font-size: 0.7rem;
            padding: 3px 8px;
        }
        
        /* 主内容区域样�?*/
        .main-content {
            flex: 1;
            border-radius: 15px;
            background: white;
            box-shadow: var(--box-shadow);
            padding: 30px;
            min-height: 500px;
        }
        
        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        
        .dashboard-title {
            font-size: 1.8rem;
            color: var(--dark-text);
            position: relative;
            display: inline-block;
        }
        
        .dashboard-title::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 40px;
            height: 3px;
            background: var(--anime-gradient);
            border-radius: 2px;
        }
        
        .dashboard-actions {
            display: flex;
            gap: 10px;
        }
        
        .dashboard-btn {
            padding: 8px 15px;
            border-radius: 8px;
            background: white;
            color: var(--dark-text);
            border: 1px solid rgba(0,0,0,0.1);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .dashboard-btn:hover {
            box-shadow: 0 3px 8px rgba(0,0,0,0.1);
            transform: translateY(-2px);
        }
        
        .dashboard-btn.primary {
            background: var(--anime-gradient);
            color: white;
            border: none;
        }
        
        /* 年级模块样式 */
        .grade-categories {
            display: flex;
            flex-direction: column;
            gap: 30px;
            margin: 20px 0;
        }
        
        .grade-category {
            background: white;
            border-radius: 15px;
            box-shadow: var(--box-shadow);
            padding: 20px;
        }
        
        .category-header {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .category-icon {
            width: 48px;
            height: 48px;
            background: var(--anime-gradient);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            color: white;
            font-size: 1.5rem;
        }
        
        .category-title {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--dark-text);
            margin: 0;
        }
        
        .grade-options {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 15px;
        }
        
        @media screen and (max-width: 992px) {
            .grade-options {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        
        @media screen and (max-width: 576px) {
            .grade-options {
                grid-template-columns: 1fr;
            }
        }
        
        .grade-option input[type="radio"] {
            display: none;
        }
        
        .grade-card {
            width: 100%;
            height: 180px;
            background: #f8f9fd;
            border-radius: 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid transparent;
            position: relative;
            overflow: hidden;
            padding: 20px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        }
        
        .grade-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(255, 107, 53, 0.15);
            background: #fff;
        }
        
        .grade-icon {
            color: var(--anime-accent);
            font-size: 1.8rem;
            margin-bottom: 15px;
            transition: all 0.3s ease;
            background: rgba(255, 107, 53, 0.1);
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }
        
        .grade-option input[type="radio"]:checked + label .grade-card {
            background: rgba(255, 107, 53, 0.08);
            border-color: var(--anime-accent);
            box-shadow: 0 8px 25px rgba(255, 107, 53, 0.2);
            transform: translateY(-8px);
        }
        
        .grade-option input[type="radio"]:checked + label .grade-icon {
            transform: scale(1.2);
            background: var(--anime-accent);
            color: white;
        }
        
        .grade-number {
            font-size: 2.8rem;
            font-weight: 700;
            color: var(--anime-accent);
            margin-bottom: 8px;
            line-height: 1;
        }
        
        .grade-name {
            font-size: 1.1rem;
            color: var(--dark-text);
            font-weight: 600;
            margin-bottom: 8px;
        }
        
        .grade-desc {
            font-size: 0.85rem;
            color: var(--gray-text);
            text-align: center;
        }
        
        /* 新增的年级介绍和特点样式 */
        .grade-intro {
            display: flex;
            margin-top: 30px;
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: var(--box-shadow);
        }
        
        .intro-content {
            flex: 1;
            padding: 25px;
        }
        
        .intro-title {
            font-size: 1.5rem;
            color: var(--dark-text);
            margin-bottom: 15px;
            font-weight: 600;
        }
        
        .intro-text {
            color: var(--gray-text);
            line-height: 1.6;
            margin-bottom: 20px;
        }
        
        .intro-features {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }
        
        .feature-item {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            width: calc(50% - 10px);
        }
        
        .feature-icon {
            width: 40px;
            height: 40px;
            background: var(--anime-gradient);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            flex-shrink: 0;
        }
        
        .feature-text h4 {
            font-size: 1rem;
            margin: 0 0 5px;
            color: var(--dark-text);
        }
        
        .feature-text p {
            font-size: 0.85rem;
            color: var(--gray-text);
            margin: 0;
            line-height: 1.4;
        }
        
        .intro-image {
            width: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: var(--light-bg);
        }
        
        .intro-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .grade-action {
            margin-top: 30px;
            display: flex;
            justify-content: center;
        }
        
        .primary-btn {
            background: var(--anime-gradient);
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 10px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(255, 107, 53, 0.3);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .primary-btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(255, 107, 53, 0.4);
        }
        
        .primary-btn i {
            font-size: 1.2rem;
        }
        
        .section-subtitle {
            color: var(--gray-text);
            margin-top: 5px;
            font-size: 0.95rem;
        }
        
        /* 选择年级提示 */
        .section-info {
            background: rgba(255, 107, 53, 0.05);
            border-left: 4px solid var(--primary-color);
            padding: 15px;
            border-radius: 4px;
            margin-bottom: 25px;
        }
        
        .section-info p {
            margin: 0;
            color: var(--dark-text);
            font-size: 0.9rem;
        }
        
        .tab-content {
            display: none;
        }
        
        .tab-content.active {
            display: block;
        }
        
        /* 用户菜单样式 */
        .user-menu {
            display: flex;
            align-items: center;
            cursor: pointer;
            position: relative;
            padding: 5px 10px;
            margin-left: 15px;
            border-radius: 20px;
            transition: var(--transition);
        }
        
        .user-menu:hover {
            background-color: rgba(255, 107, 53, 0.1);
        }
        
        .user-menu-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            margin-right: 8px;
            border: 2px solid var(--primary-color);
        }
        
        .user-menu .user-name {
            font-weight: 500;
            margin-right: 8px;
            color: var(--dark-text);
        }
        
        .user-menu i {
            font-size: 12px;
            color: var(--gray-text);
            transition: transform 0.3s ease;
        }
        
        .user-menu:hover i {
            transform: rotate(180deg);
        }
        
        .user-dropdown {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 180px;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
            padding: 10px 0;
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px);
            transition: all 0.3s ease;
            z-index: 100;
        }
        
        .user-menu:hover .user-dropdown {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
        
        .dropdown-item {
            display: flex;
            align-items: center;
            padding: 10px 15px;
            color: var(--dark-text);
            transition: var(--transition);
        }
        
        .dropdown-item:hover {
            background-color: rgba(255, 107, 53, 0.1);
            color: var(--primary-color);
        }
        
        .dropdown-item i {
            margin-right: 10px;
            width: 20px;
            text-align: center;
            color: var(--gray-text);
        }
        
        .dropdown-item:last-child {
            border-top: 1px solid rgba(0, 0, 0, 0.05);
            margin-top: 5px;
        }
        
        /* 学科选择样式 */
        .subject-selection {
            margin-bottom: 30px;
        }
        
        /* 网格布局 */
        .subject-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }
        
        /* 卡片样式，保留这里的定义 */
        .subject-card {
            display: flex;
            flex-direction: row;
            align-items: center;
            padding: 20px;
            border-radius: 12px;
            background: white;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
            border: 1px solid rgba(0, 0, 0, 0.05);
            height: 100%;
        }
        
        .subject-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(255, 107, 53, 0.1);
            border-color: rgba(255, 107, 53, 0.2);
        }
        
        .subject-icon {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 107, 53, 0.1);
            border-radius: 50%;
            margin-right: 15px;
            flex-shrink: 0;
            color: var(--anime-accent);
            font-size: 1.5rem;
            transition: all 0.3s ease;
        }
        
        .subject-card:hover .subject-icon {
            transform: scale(1.1);
            background: var(--anime-accent);
            color: white;
        }
        
        .subject-info {
            flex: 1;
        }
        
        .subject-name {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--dark-text);
            margin-bottom: 5px;
        }
        
        .subject-desc {
            font-size: 0.85rem;
            color: var(--gray-text);
            margin-bottom: 10px;
            line-height: 1.5;
        }
        
        .subject-action {
            margin-left: 15px;
        }
        
        .subject-btn {
            background: transparent;
            border: 2px solid var(--anime-accent);
            color: var(--anime-accent);
            border-radius: 8px;
            padding: 8px 15px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
            white-space: nowrap;
        }
        
        .subject-btn:hover {
            background: var(--anime-gradient);
            color: white;
            border-color: transparent;
        }
        
        /* 学习进度样式 */
        .subject-progress {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.05);
        }
        
        .subject-progress h3 {
            margin-bottom: 15px;
            font-size: 1.2rem;
            color: var(--dark-text);
            position: relative;
            display: inline-block;
        }
        
        .subject-progress h3::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 30px;
            height: 2px;
            background: var(--anime-gradient);
            border-radius: 2px;
        }
        
        .progress-container {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        
        .progress-item {
            width: 100%;
        }
        
        .progress-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
            font-size: 0.9rem;
            color: var(--dark-text);
        }
        
        .progress-bar {
            height: 8px;
            background-color: rgba(0,0,0,0.05);
            border-radius: 4px;
            overflow: hidden;
        }
        
        .progress-fill {
            height: 100%;
            background: var(--anime-gradient);
            border-radius: 4px;
            transition: width 0.5s ease;
        }
        
        .progress-text {
            font-size: 0.8rem;
            color: var(--gray-text);
            margin-top: 5px;
            text-align: right;
        }

        /* 课程学习样式 */
        .section-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin: 30px 0 20px;
            color: var(--dark-text);
            position: relative;
            padding-left: 12px;
        }
        
        .section-title::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 4px;
            background: var(--anime-gradient);
            border-radius: 2px;
        }
        
        .courses-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .course-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.05);
            overflow: hidden;
            transition: var(--transition);
        }
        
        .course-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(255, 107, 53, 0.1);
        }
        
        .course-image {
            height: 160px;
            position: relative;
            overflow: hidden;
        }
        
        .course-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        
        .course-card:hover .course-image img {
            transform: scale(1.05);
        }
        
        .course-progress {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 0.8rem;
        }
        
        .course-tag {
            position: absolute;
            top: 10px;
            left: 10px;
            background: var(--anime-gradient);
            color: white;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 0.8rem;
        }
        
        .course-content {
            padding: 15px;
        }
        
        .course-category {
            font-size: 0.8rem;
            color: var(--primary-color);
            margin-bottom: 5px;
        }
        
        .course-title {
            font-weight: 600;
            color: var(--dark-text);
            margin-bottom: 8px;
            font-size: 1.1rem;
        }
        
        .course-info {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            color: var(--gray-text);
            margin-bottom: 15px;
        }
        
        .course-info span {
            display: flex;
            align-items: center;
        }
        
        .course-info i {
            margin-right: 5px;
        }
        
        .course-btn {
            width: 100%;
            padding: 8px;
            border: none;
            border-radius: 6px;
            background: rgba(255, 107, 53, 0.1);
            color: var(--primary-color);
            cursor: pointer;
            font-weight: 500;
            transition: var(--transition);
        }
        
        .course-btn:hover {
            background: var(--anime-gradient);
            color: white;
        }
        
        /* 家庭作业样式 */
        .homework-list {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        
        .homework-item {
            display: flex;
            background: white;
            border-radius: 12px;
            padding: 15px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.05);
            transition: var(--transition);
            border-left: 4px solid transparent;
        }
        
        .homework-item:hover {
            box-shadow: 0 6px 15px rgba(0,0,0,0.08);
            border-left-color: var(--primary-color);
        }
        
        .homework-status {
            flex-shrink: 0;
            width: 100px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            color: var(--gray-text);
        }
        
        .homework-status i {
            font-size: 1.8rem;
            margin-bottom: 5px;
            color: var(--primary-color);
        }
        
        .homework-status.urgent {
            color: #f44336;
        }
        
        .homework-status.urgent i {
            color: #f44336;
        }
        
        .homework-info {
            flex: 1;
            padding: 0 15px;
        }
        
        .homework-title {
            font-weight: 600;
            color: var(--dark-text);
            margin-bottom: 5px;
            font-size: 1.1rem;
        }
        
        .homework-desc {
            color: var(--gray-text);
            font-size: 0.9rem;
            margin-bottom: 10px;
        }
        
        .homework-meta {
            display: flex;
            gap: 15px;
            font-size: 0.8rem;
            color: var(--gray-text);
        }
        
        .homework-meta span {
            display: flex;
            align-items: center;
        }
        
        .homework-meta i {
            margin-right: 5px;
            color: var(--primary-color);
        }
        
        .homework-actions {
            display: flex;
            align-items: center;
        }
        
        .homework-btn {
            padding: 8px 15px;
            border: none;
            border-radius: 6px;
            background: rgba(255, 107, 53, 0.1);
            color: var(--primary-color);
            cursor: pointer;
            font-weight: 500;
            transition: var(--transition);
        }
        
        .homework-btn:hover {
            background: var(--anime-gradient);
            color: white;
        }
        
        /* 个人资料样式 */
        .profile-container {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 30px;
        }
        
        .profile-avatar {
            position: relative;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            overflow: hidden;
            margin: 0 auto 20px;
            border: 3px solid var(--primary-color);
        }
        
        .profile-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .avatar-change-btn {
            position: absolute;
            bottom: 10px;
            right: 10px;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--primary-color);
            color: white;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }
        
        .avatar-change-btn:hover {
            background: var(--dark-text);
        }
        
        .profile-form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        
        .form-group {
            margin-bottom: 10px;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 500;
            color: var(--dark-text);
        }
        
        .form-control {
            width: 100%;
            padding: 10px;
            border: 1px solid rgba(0,0,0,0.1);
            border-radius: 8px;
            font-family: inherit;
            transition: var(--transition);
        }
        
        .form-control:focus {
            border-color: var(--primary-color);
            outline: none;
        }
        
        .form-row {
            display: flex;
            gap: 15px;
        }
        
        .form-group.half {
            flex: 1;
        }
        
        textarea.form-control {
            min-height: 80px;
            resize: vertical;
        }
        
        .profile-achievements {
            grid-column: 1 / -1;
            margin-top: 20px;
        }
        
        .profile-achievements h3 {
            font-size: 1.2rem;
            color: var(--dark-text);
            margin-bottom: 15px;
            position: relative;
            display: inline-block;
        }
        
        .profile-achievements h3::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 30px;
            height: 2px;
            background: var(--anime-gradient);
            border-radius: 2px;
        }
        
        .achievements-container {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }
        
        .achievement-item {
            display: flex;
            align-items: center;
            padding: 10px 15px;
            background: rgba(255, 107, 53, 0.05);
            border-radius: 8px;
            transition: var(--transition);
        }
        
        .achievement-item:hover {
            background: rgba(255, 107, 53, 0.1);
            transform: translateY(-3px);
        }
        
        .achievement-icon {
            width: 30px;
            height: 30px;
            background: var(--anime-gradient);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            margin-right: 10px;
        }
        
        .achievement-name {
            font-weight: 500;
            color: var(--dark-text);
        }
        
        /* 游戏模块样式 */
        .games-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .game-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.05);
            overflow: hidden;
            transition: var(--transition);
        }
        
        .game-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(255, 107, 53, 0.1);
        }
        
        .game-image {
            height: 160px;
            position: relative;
            overflow: hidden;
        }
        
        .game-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        
        .game-card:hover .game-image img {
            transform: scale(1.05);
        }
        
        .game-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 0.8rem;
            color: white;
        }
        
        .game-badge.hot {
            background: linear-gradient(45deg, #ff416c, #ff4b2b);
        }
        
        .game-badge.new {
            background: linear-gradient(45deg, #11998e, #38ef7d);
        }
        
        .game-badge.reward {
            background: linear-gradient(45deg, #f2994a, #f2c94c);
        }
        
        .game-content {
            padding: 15px;
        }
        
        .game-title {
            font-weight: 600;
            color: var(--dark-text);
            margin-bottom: 8px;
            font-size: 1.1rem;
        }
        
        .game-desc {
            font-size: 0.85rem;
            color: var(--gray-text);
            margin-bottom: 15px;
            height: 40px;
            overflow: hidden;
        }
        
        .game-meta {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            color: var(--gray-text);
            margin-bottom: 15px;
        }
        
        .game-meta span {
            display: flex;
            align-items: center;
        }
        
        .game-meta i {
            margin-right: 5px;
            color: var(--primary-color);
        }
        
        .game-btn {
            width: 100%;
            padding: 8px;
            border: none;
            border-radius: 6px;
            background: rgba(255, 107, 53, 0.1);
            color: var(--primary-color);
            cursor: pointer;
            font-weight: 500;
            transition: var(--transition);
        }
        
        .game-btn:hover {
            background: var(--anime-gradient);
            color: white;
        }
        
        .game-achievements {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.05);
        }
        
        .achievement-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 25px;
        }
        
        .stat-item {
            text-align: center;
            padding: 15px 10px;
            background: rgba(255, 107, 53, 0.05);
            border-radius: 10px;
            transition: var(--transition);
        }
        
        .stat-item:hover {
            background: rgba(255, 107, 53, 0.1);
            transform: translateY(-3px);
        }
        
        .stat-value {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 5px;
        }
        
        .stat-label {
            font-size: 0.85rem;
            color: var(--gray-text);
        }
        
        .recent-achievements {
            margin-top: 20px;
        }
        
        .recent-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--dark-text);
            margin-bottom: 15px;
        }
        
        .recent-list {
            display: flex;
            gap: 15px;
            overflow-x: auto;
            padding: 5px 0 15px;
        }
        
        .recent-item {
            display: flex;
            align-items: center;
            padding: 15px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 3px 8px rgba(0,0,0,0.05);
            min-width: 280px;
            transition: var(--transition);
        }
        
        .recent-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }
        
        .medal-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-right: 15px;
            color: white;
        }
        
        .medal-icon.gold {
            background: linear-gradient(45deg, #FFD700, #FFA500);
        }
        
        .medal-icon.silver {
            background: linear-gradient(45deg, #C0C0C0, #A9A9A9);
        }
        
        .medal-icon.bronze {
            background: linear-gradient(45deg, #CD7F32, #8B4513);
        }
        
        .medal-name {
            font-weight: 600;
            color: var(--dark-text);
            margin-bottom: 5px;
        }
        
        .medal-desc {
            font-size: 0.8rem;
            color: var(--gray-text);
        }
        
        /* 社区模块样式 */
        .community-tabs {
            display: flex;
            border-bottom: 1px solid rgba(0,0,0,0.1);
            margin-bottom: 20px;
        }
        
        .community-tab {
            padding: 10px 20px;
            font-weight: 500;
            color: var(--gray-text);
            cursor: pointer;
            position: relative;
            transition: var(--transition);
        }
        
        .community-tab:hover {
            color: var(--primary-color);
        }
        
        .community-tab.active {
            color: var(--primary-color);
        }
        
        .community-tab.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            height: 2px;
            background: var(--primary-color);
        }
        
        .post-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .post-item {
            display: flex;
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.05);
            transition: var(--transition);
        }
        
        .post-item:hover {
            box-shadow: 0 6px 15px rgba(0,0,0,0.08);
            transform: translateY(-3px);
        }
        
        .post-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            overflow: hidden;
            margin-right: 15px;
            flex-shrink: 0;
        }
        
        .post-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .post-content {
            flex: 1;
        }
        
        .post-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }
        
        .post-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .post-author {
            font-weight: 600;
            color: var(--dark-text);
        }
        
        .post-time {
            font-size: 0.8rem;
            color: var(--gray-text);
        }
        
        .post-tags {
            display: flex;
            gap: 8px;
        }
        
        .post-tag {
            font-size: 0.7rem;
            padding: 3px 8px;
            border-radius: 20px;
            color: white;
        }
        
        .post-tag.study {
            background: linear-gradient(45deg, #6a11cb, #2575fc);
        }
        
        .post-tag.resource {
            background: linear-gradient(45deg, #11998e, #38ef7d);
        }
        
        .post-tag.official {
            background: linear-gradient(45deg, #f2994a, #f2c94c);
        }
        
        .post-title {
            font-weight: 600;
            color: var(--dark-text);
            margin-bottom: 10px;
            font-size: 1.1rem;
        }
        
        .post-text {
            font-size: 0.9rem;
            color: var(--gray-text);
            margin-bottom: 15px;
            line-height: 1.5;
        }
        
        .post-attach {
            background: rgba(0,0,0,0.03);
            padding: 10px 15px;
            border-radius: 8px;
            margin-bottom: 15px;
        }
        
        .attach-file {
            display: flex;
            align-items: center;
            font-size: 0.9rem;
            color: var(--primary-color);
        }
        
        .attach-file i {
            margin-right: 10px;
        }
        
        .post-actions {
            display: flex;
            gap: 20px;
        }
        
        .post-action {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 0.9rem;
            color: var(--gray-text);
            cursor: pointer;
            transition: var(--transition);
        }
        
        .post-action:hover {
            color: var(--primary-color);
        }
        
        .community-pagination {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 20px;
        }
        
        .page-link {
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: white;
            color: var(--gray-text);
            font-weight: 500;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            transition: var(--transition);
        }
        
        .page-link:hover {
            background: rgba(255, 107, 53, 0.1);
            color: var(--primary-color);
        }
        
        .page-link.active {
            background: var(--primary-color);
            color: white;
        }
        
        .page-link.next {
            width: auto;
            padding: 0 15px;
        }
        
        /* 公益商城样式 */
        .charity-stats {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.05);
            margin-bottom: 20px;
        }
        
        .charity-header {
            margin-bottom: 15px;
        }
        
        .charity-header h3 {
            font-size: 1.2rem;
            color: var(--dark-text);
            position: relative;
            display: inline-block;
        }
        
        .charity-header h3::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 30px;
            height: 2px;
            background: var(--anime-gradient);
            border-radius: 2px;
        }
        
        .stats-container {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }
        
        .stats-item {
            display: flex;
            align-items: center;
            padding: 15px;
            background: rgba(255, 107, 53, 0.05);
            border-radius: 10px;
            transition: var(--transition);
        }
        
        .stats-item:hover {
            background: rgba(255, 107, 53, 0.1);
            transform: translateY(-3px);
        }
        
        .stats-icon {
            width: 45px;
            height: 45px;
            background: var(--anime-gradient);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            margin-right: 12px;
        }
        
        .stats-info {
            flex: 1;
        }
        
        .stats-value {
            font-weight: 700;
            color: var(--dark-text);
            font-size: 1.2rem;
            margin-bottom: 3px;
        }
        
        .stats-label {
            font-size: 0.8rem;
            color: var(--gray-text);
        }
        
        .my-contribution {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.05);
            margin-bottom: 20px;
        }
        
        .contribution-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .contribution-header h3 {
            font-size: 1.2rem;
            color: var(--dark-text);
        }
        
        .my-points {
            display: flex;
            align-items: center;
            background: rgba(255, 193, 7, 0.1);
            padding: 8px 15px;
            border-radius: 8px;
            color: #ff9800;
        }
        
        .my-points i {
            margin-right: 8px;
        }
        
        .my-points strong {
            font-weight: 700;
        }
        
        .contribution-content {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        
        .contribution-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }
        
        .contribution-item {
            text-align: center;
            padding: 15px;
            background: rgba(255, 107, 53, 0.05);
            border-radius: 10px;
            transition: var(--transition);
        }
        
        .contribution-item:hover {
