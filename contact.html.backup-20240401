        .location-contact a {
            color: var(--accent-color);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: color 0.3s ease;
        }
        
        .location-contact a:hover {
            color: var(--primary-color);
        }
        
        .location-contact i {
