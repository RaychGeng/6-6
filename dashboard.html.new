    <!-- JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
        // 初始化AOS动画
        AOS.init({
            duration: 800,
            easing: 'ease-in-out',
            once: true
        });
        
        // 导航切换
        document.addEventListener('DOMContentLoaded', function() {
            // 年级选择功能
            const gradeOptions = document.querySelectorAll('.grade-option input[type="radio"]');
            const confirmGradeBtn = document.getElementById('confirm-grade');
            
            // 确认年级选择
            if (confirmGradeBtn) {
                confirmGradeBtn.addEventListener('click', function() {
                    const selectedGrade = document.querySelector('.grade-option input[type="radio"]:checked');
                    
                    if (selectedGrade) {
                        const gradeId = selectedGrade.id;
                        const gradeName = selectedGrade.closest('.grade-option').querySelector('.grade-name').textContent;
                        
                        // 更新用户信息中的年级显示
                        const userLevelElement = document.querySelector('.user-level');
                        if (userLevelElement) {
                            userLevelElement.textContent = gradeName + ' · 学习达人';
                        }
                        
                        // 保存选择到本地存�?                        localStorage.setItem('selected-grade', gradeId);
                        
                        // 显示成功消息
                        alert('年级选择成功�? + gradeName);
                        
                        // 切换回主界面
                        const tabs = document.querySelectorAll('.tab-content');
                        tabs.forEach(tab => tab.classList.remove('active'));
                        document.getElementById('dashboard-home').classList.add('active');
                    } else {
                        alert('请先选择一个年级！');
                    }
                });
            }
            
            // 侧边栏年级选择导航点击事件
            const gradeNavItems = document.querySelectorAll('.nav-item');
            gradeNavItems.forEach(item => {
                const spanElement = item.querySelector('span');
                if (spanElement && spanElement.textContent === '年级选择') {
                    item.addEventListener('click', function() {
                        // 切换到年级选择界面
                        const tabs = document.querySelectorAll('.tab-content');
                        tabs.forEach(tab => tab.classList.remove('active'));
                        document.getElementById('grade-selection').classList.add('active');
                        
                        // 恢复之前选择的年�?                        const savedGrade = localStorage.getItem('selected-grade');
                        if (savedGrade) {
                            const savedGradeElement = document.getElementById(savedGrade);
                            if (savedGradeElement) {
                                savedGradeElement.checked = true;
                            }
                        }
                    });
                }
            });
            
            // 科目选择导航点击事件
            const subjectNavItems = document.querySelectorAll('.nav-item');
            subjectNavItems.forEach(item => {
                const spanElement = item.querySelector('span');
                if (spanElement && spanElement.textContent === '科目选择') {
                    item.addEventListener('click', function() {
                        // 切换到科目选择界面
                        const tabs = document.querySelectorAll('.tab-content');
                        tabs.forEach(tab => tab.classList.remove('active'));
                        document.getElementById('subject-selection').classList.add('active');
                        
                        // 获取当前选中的年�?                        const selectedGrade = localStorage.getItem('selected-grade');
                        if (!selectedGrade) {
                            // 如果未选择年级，先切换到年级选择界面
                            document.getElementById('grade-selection').classList.add('active');
                            document.getElementById('subject-selection').classList.remove('active');
                            alert('请先选择年级�?);
                            return;
                        }
                        
                        // 根据年级调整科目内容
                        updateSubjectsForGrade(selectedGrade);
                    });
                }
            });
            
            // 益智游戏导航点击事件
            const gameNavItems = document.querySelectorAll('.nav-item');
            gameNavItems.forEach(item => {
                const spanElement = item.querySelector('span');
                if (spanElement && spanElement.textContent === '益智游戏') {
                    item.addEventListener('click', function() {
                        // 使用games-module.js中的函数
                        if (typeof window.showGamesInMainContent === 'function') {
                            window.showGamesInMainContent();
                        } else {
                            console.error('游戏模块未正确加�?);
                            alert('游戏模块加载失败，请稍后再试');
                        }
                        
                        // 移除所有菜单项的active�?                        gameNavItems.forEach(nav => nav.classList.remove('active'));
                        
                        // 给当前点击的菜单项添加active�?                        this.classList.add('active');
                    });
                }
            });
            
            // 科目卡片点击事件
            const subjectCards = document.querySelectorAll('.subject-card');
            subjectCards.forEach(card => {
                const startButton = card.querySelector('.subject-btn');
                if (startButton) {
                    startButton.addEventListener('click', function(e) {
                        e.stopPropagation(); // 防止事件冒泡
                        const subjectName = card.querySelector('.subject-name').textContent;
                        // 这里可以添加跳转到具体科目学习页面的逻辑
                        showNotification('正在开发相应功能，敬请期待...', 'info');
                    });
                }
            });
            
            // 推荐学习路径按钮点击事件
            const recommendationBtns = document.querySelectorAll('.recommendation-btn');
            recommendationBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const recommendationTitle = btn.closest('.recommendation-item').querySelector('h4').textContent;
                    showNotification('正在开发相应功能，敬请期待...', 'info');
                    // 这里可以添加跳转到具体学习路径页面的逻辑
                });
            });
            
            // 根据年级更新科目内容
            function updateSubjectsForGrade(gradeId) {
                const gradeNumber = gradeId.split('-')[1]; // 提取年级数字
                const infoText = document.querySelector('.section-info p');
                if (infoText) {
                    // 更新信息提示
                    const gradeName = ['一', '�?, '�?, '�?, '�?, '�?][parseInt(gradeNumber) - 1] || '�?;
                    infoText.innerHTML = `<i class="fas fa-info-circle"></i> 当前显示的是${gradeName}年级科目，科目内容会根据您选择的年级自动调整`;
                }
                
                // 这里可以根据不同年级调整科目的难度描述和进度等信�?                // 为了演示，这里只模拟了不同年级的完成进度变化
                const progressBars = document.querySelectorAll('.subject-card .progress-fill');
                const progressTexts = document.querySelectorAll('.subject-card .progress-text');
                
                // 模拟不同年级的完成进�?                const progressData = {
                    'grade-1': [15, 20, 10, 5, 25, 30, 35, 10],
                    'grade-2': [25, 30, 15, 10, 35, 40, 30, 20],
                    'grade-3': [35, 40, 25, 15, 30, 45, 20, 25],
                    'grade-4': [45, 50, 35, 25, 40, 55, 15, 30],
                    'grade-5': [60, 55, 40, 30, 50, 65, 25, 35],
                    'grade-6': [75, 60, 45, 30, 55, 80, 20, 40]
                };
                
                // 应用进度数据
                const currentProgress = progressData[gradeId] || progressData['grade-6'];
                progressBars.forEach((bar, index) => {
                    if (index < currentProgress.length) {
                        const progress = currentProgress[index];
                        bar.style.width = `${progress}%`;
                        if (progressTexts[index]) {
                            progressTexts[index].textContent = `已完�?${progress}%`;
                        }
                    }
                });
            }
        });
    </script>
    
    <!-- 引入游戏模块JS -->
    <script src="games-module.js"></script>
    
    <!-- 引入游戏图片修复JS -->
    <script src="game-image-fix.js"></script>
    
    <!-- 内联飞花令游戏代�?-->
    <script>
        // 内联飞花令游戏代码，避免编码问题
        document.addEventListener('DOMContentLoaded', function() {
            // 保留游戏菜单样式函数，因为这不会冲突
            function addGameMenuStyles() {
                // 检查是否已添加样式
                if (document.getElementById('games-menu-styles')) return;
                
                const styleElement = document.createElement('style');
                styleElement.id = 'games-menu-styles';
                styleElement.textContent = `
                    .games-container {
                        display: grid;
                        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
                        gap: 20px;
                        margin-top: 20px;
                    }
                    
                    .game-card {
                        background: white;
                        border-radius: 10px;
                        overflow: hidden;
                        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
                        transition: transform 0.3s ease, box-shadow 0.3s ease;
                    }
                    
                    .game-card:hover {
                        transform: translateY(-5px);
                        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
                    }
                    
                    .game-image {
                        position: relative;
                        height: 180px;
                        overflow: hidden;
                    }
                    
                    .game-image img {
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                    }
                    
                    .game-badge {
                        position: absolute;
                        top: 10px;
                        right: 10px;
                        padding: 5px 10px;
                        border-radius: 15px;
                        font-size: 12px;
                        font-weight: bold;
                        color: white;
                    }
                    
                    .game-badge.hot {
                        background: linear-gradient(45deg, #FF416C, #FF4B2B);
                    }
                    
                    .game-badge.new {
                        background: linear-gradient(45deg, #11998e, #38ef7d);
                    }
                    
                    .game-content {
                        padding: 15px;
                    }
                    
                    .game-title {
                        font-size: 18px;
                        font-weight: 600;
                        margin-bottom: 8px;
                        color: #333;
                    }
                    
                    .game-desc {
                        font-size: 14px;
                        color: #666;
                        margin-bottom: 15px;
                        line-height: 1.4;
                    }
                    
                    .game-meta {
                        display: flex;
                        justify-content: space-between;
                        font-size: 13px;
                        color: #888;
                        margin-bottom: 15px;
                    }
                    
                    .game-btn {
                        width: 100%;
                        padding: 10px;
                        background: linear-gradient(135deg, #FF6B35 0%, #FFC107 100%);
                        color: white;
                        border: none;
                        border-radius: 5px;
                        font-weight: 600;
                        cursor: pointer;
                        transition: all 0.2s ease;
                    }
                    
                    .game-btn:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 5px 10px rgba(255, 107, 53, 0.3);
                    }
                `;
                
                document.head.appendChild(styleElement);
            }
        });
    </script>
</body>
</html> 
