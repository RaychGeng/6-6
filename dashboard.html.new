    </header>

    <!-- 主要内容区域 -->
    <div class="container">
        <div class="dashboard">
            <!-- 左侧导航�?-->
            <div class="sidebar">
                <div class="user-profile">
                    <div class="user-avatar">
                        <img src="images/avatar.jpg" alt="用户头像">
                    </div>
