            margin: 0 auto 30px;
            color: #666;
        }
        
        .support-options {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
            margin-top: 40px;
        }
        
        .support-option {
            background: #fff;
            padding: 30px;
            border-radius: 10px;
            max-width: 300px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
